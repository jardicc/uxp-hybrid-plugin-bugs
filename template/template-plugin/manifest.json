{
    "id": "com.adobe.testPlugin",
    "name": "UXP Hybrid SDK Bug Repro Suite",
    "manifestVersion": 6,
    "version": "1.0.0",
    "main": "index.html",
    "host": {
        "app": "PS",
        "minVersion": "24.2.0",
        "data": {
            "apiVersion": 2
        }
    },
    "entryPoints": [
        {
            "type": "panel",
            "id": "bugReproPanel",
            "label": {
                "default": "UXP Hybrid Bug Repro Suite"
            },
            "minimumSize": {
                "width": 380,
                "height": 400
            },
            "maximumSize": {
                "width": 2400,
                "height": 2400
            },
            "preferredDockedSize": {
                "width": 460,
                "height": 800
            },
            "preferredFloatingSize": {
                "width": 720,
                "height": 900
            }
        },
        {
            "type": "command",
            "label": "test MyFunction",
            "id": "testMyFunction"
        },
        {
            "type": "command",
            "label": "test MyEcho",
            "id": "testMyEcho"
        },
        {
            "type": "command",
            "label": "test MyAsyncEcho",
            "id": "testMyAsyncEcho"
        }
    ],
    "addon": {
        "name": "sample-uxp-addon.uxpaddon"
    },
    "requiredPermissions": {
        "enableAddon": true
    },
    "icons": [
        {
            "width": 24,
            "height": 24,
            "path": "icons/plugin@1x.png"
        },
        {
            "width": 48,
            "height": 48,
            "path": "icons/plugin@2x.png"
        }
    ]
}
